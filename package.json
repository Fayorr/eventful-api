{
	"name": "eventful-api",
	"version": "2.0.0",
	"description": "AltSchool Backend Engineering Capstone - Eventful",
	"main": "dist/server.js",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "ts-node-dev --respawn --transpile-only src/server.ts",
		"worker": "node dist/worker.js",
		"worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
		"build": "tsc",
		"test": "jest --runInBand",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@prisma/client": "6.19.3",
		"@supabase/supabase-js": "2.115.0",
		"bullmq": "6.3.4",
		"cloudinary": "^2.10.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "5.2.1",
		"express-rate-limit": "^7.1.1",
		"helmet": "^7.1.0",
		"ioredis": "^5.11.0",
		"qrcode": "^1.5.3",
		"rate-limit-redis": "^4.2.0",
		"resend": "^6.12.4",
		"supertest": "^7.2.2",
		"swagger-ui-express": "^5.0.0",
		"yamljs": "^0.3.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@types/cors": "^2.8.16",
		"@types/express": "5.0.6",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.9.0",
		"@types/qrcode": "^1.5.5",
		"@types/supertest": "^7.2.0",
		"@types/swagger-ui-express": "^4.1.6",
		"@types/yamljs": "^0.2.34",
		"jest": "^29.7.0",
		"prisma": "6.19.3",
		"ts-jest": "^29.1.1",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.2.2"
	},
	"overrides": {
		"deepmerge-ts": "8.0.2",
		"qs": "6.16.0"
	}
}
