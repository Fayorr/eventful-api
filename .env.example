NODE_ENV=development
PORT=5001
FRONTEND_URL=https://eventfulapp-api.vercel.app
BACKEND_URL=https://eventful-api.hostless.app
CORS_ORIGINS=https://eventfulapp-api.vercel.app,http://localhost:5173

# Supabase Postgres. Use the session pooler for a persistent API server.
DATABASE_URL=postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Supabase Auth. Never expose the secret/service-role key to the frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

REDIS_URL=redis://127.0.0.1:6379
PAYSTACK_SECRET_KEY=sk_test_replace_me
RESEND_API_KEY=re_replace_me
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
